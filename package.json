{
  "name": "statlab",
  "version": "1.0.0",
  "description": "StatLab — Statistics & Probability Study App",
  "main": "main.js",
  "author": "YOUNG SASS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "electron-winstaller": "^5.4.4"
  },
  "build": {
    "appId": "com.youngsass.statlab",
    "productName": "StatLab",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "mathjs": "^15.2.0"
  }
}
